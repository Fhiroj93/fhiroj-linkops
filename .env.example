# Supabase project (Settings -> API in your Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# n8n webhook used for the "Scrape Now" instant-scrape action on the dashboard.
# This is the only outbound webhook call the app makes directly — every other
# write goes straight to Supabase and is picked up by a Supabase Database
# Webhook configured separately (see README > Architecture).
VITE_SCRAPE_WEBHOOK_URL=